def command_deepseek(args: argparse.Namespace) -> int:
    config_file = config_path()
    if not config_file.exists():
        print("Codex config.toml not found. Is Codex installed?", file=sys.stderr)
        return 1

    text = load_text(config_file)
    parsed = parse_toml(text)

    if parsed.get("model_provider") == DEEPSEEK_PROVIDER:
        # Already on DeepSeek: still persist the key so it survives future switches.
        token = existing_token(parsed) or load_stored_key()
        if token:
            save_deepseek_key(token)
            print("DeepSeek API key persisted for future switches.")
        print("Already using DeepSeek.", file=sys.stderr)
        return 0

    token = args.api_key or existing_token(parsed) or load_stored_key()
    if not token:
        print(
            "No DeepSeek API key found.\n"
            "  Run: codex-api-switch key set 'sk-...'  (saved for future switches)\n"
            "  Or:  codex-api-switch deepseek --api-key 'sk-...'\n"
            "  Or set DEEPSEEK_API_KEY environment variable.",
            file=sys.stderr,
        )
        return 2
    if not token.startswith("sk-"):
        print(
            "DeepSeek API key should start with 'sk-'. No files were changed.",
            file=sys.stderr,
        )
        return 2

    codex_home().mkdir(parents=True, exist_ok=True)
    make_backup("before-deepseek")
    save_restore_points()
    config_file.write_text(render_deepseek_config(text, token), encoding="utf-8")
    write_models_catalog()
    save_deepseek_key(token)

    print(f"Switched to DeepSeek ({DEEPSEEK_MODEL}).")
    print("DeepSeek API key saved for future switches (codex-api-switch key status).")
    if args.no_sync:
        print("History label sync skipped (--no-sync).")
    elif is_codex_running():
        print(
            "NOTE: Codex desktop is still running, so history labels were NOT synced.\n"
            "      Fully quit Codex (Cmd+Q), then run: codex-api-switch sync",
        )
    else:
        result = sync_history(DEEPSEEK_PROVIDER)
        if result["updated"]:
            print(f"History synced: {result['updated']} conversation(s) relabeled to deepseek.")
        elif not result["errors"]:
            print("History labels already match deepseek.")
        for error in result["errors"]:
            print(f"ERROR: {error}", file=sys.stderr)
        if result["backup_dir"]:
            print(f"Backup: {result['backup_dir']}")
    return 0


def command_openai(args: argparse.Namespace) -> int:
    restore_config = backup_dir() / "openai-last.toml"
    if not restore_config.exists():
        print(
            "No OpenAI restore point found.\n"
            "You must switch to DeepSeek at least once for a restore point to be created.",
            file=sys.stderr,
        )
        return 2

    config_file = config_path()
    if not config_file.exists():
        print("Codex config.toml not found.", file=sys.stderr)
        return 1

    parsed = parse_toml(load_text(config_file))
    if parsed.get("model_provider") != DEEPSEEK_PROVIDER:
        print("Already using OpenAI.", file=sys.stderr)
        return 0

    deepseek_token = (
        parsed.get("model_providers", {})
        .get(DEEPSEEK_PROVIDER, {})
        .get("experimental_bearer_token")
    )
    if deepseek_token:
        save_deepseek_key(str(deepseek_token))

    make_backup("before-openai")
    shutil.copy2(restore_config, config_file)

    if (backup_dir() / "models-last.json").exists():
        shutil.copy2(backup_dir() / "models-last.json", models_path())
    elif (backup_dir() / "models-was-absent").exists():
        models_path().unlink(missing_ok=True)

    openai_provider = parse_toml(load_text(config_file)).get("model_provider") or "openai"
    print("Restored to OpenAI config.")
    if args.no_sync:
        print("History label sync skipped (--no-sync).")
    elif is_codex_running():
        print(
            "NOTE: Codex desktop is still running, so history labels were NOT synced.\n"
            "      Fully quit Codex (Cmd+Q), then run: codex-api-switch sync",
        )
    else:
        result = sync_history(openai_provider)
        if result["updated"]:
            print(f"History synced: {result['updated']} conversation(s) relabeled to {openai_provider}.")
        elif not result["errors"]:
            print("History labels already match the OpenAI provider.")
        for error in result["errors"]:
            print(f"ERROR: {error}", file=sys.stderr)
        if result["backup_dir"]:
            print(f"Backup: {result['backup_dir']}")
    return 0


def command_status(args: argparse.Namespace) -> int:
    text = load_text(config_path())
    if not text.strip():
        msg = "No config.toml found." if not args.json else json.dumps({"error": "no config"})
        print(msg)
        return 0

    try:
        parsed = parse_toml(text)
    except Exception as exc:
        if args.json:
            print(json.dumps({"error": f"TOML parse error: {exc}"}))
        else:
            print(f"Config parse error: {exc}", file=sys.stderr)
        return 1

    if args.json:
        status = get_status_dict()
        print(json.dumps(status, ensure_ascii=False, indent=2))
        return 0

    provider = parsed.get("model_provider") or "openai"
    model = parsed.get("model", "(not set)")
    deepseek = parsed.get("model_providers", {}).get(DEEPSEEK_PROVIDER, {})

    print(f"Codex home: {codex_home()}")
    print(f"Model: {model}")
    print(f"Provider: {provider}")

    if deepseek:
        token = deepseek.get("experimental_bearer_token", "")
        masked = masked_key(token)
        print(f"DeepSeek URL: {deepseek.get('base_url', '(missing)')}")
        print(f"DeepSeek key: {masked}")
    else:
        print("DeepSeek: not configured")
    stored = load_stored_key()
    print(f"DeepSeek key saved: {masked_key(stored)}")

    if (backup_dir() / "openai-last.toml").exists():
        print("Restore point: available")
    else:
        print("Restore point: none (switch to DeepSeek first to create one)")

    if is_codex_running():
        print("Codex desktop: running (history sync requires quitting first)")
    else:
        print("Codex desktop: not running (history sync is safe)")
    return 0


def command_key(args: argparse.Namespace) -> int:
    if args.action == "set":
        value = (args.value or "").strip()
        if not value.startswith("sk-"):
            print("DeepSeek API key should start with 'sk-'. Nothing saved.", file=sys.stderr)
            return 2
        save_deepseek_key(value)
        print(f"DeepSeek API key saved ({masked_key(value)}).")
        return 0
    if args.action == "clear":
        clear_deepseek_key()
        print("Saved DeepSeek API key cleared. You will be asked again on next switch.")
        return 0
    # status
    stored = load_stored_key()
    print(f"Saved DeepSeek API key: {masked_key(stored)}")
    print("Edit:   codex-api-switch key set 'sk-...'")
    print("Clear:  codex-api-switch key clear")
    return 0


def command_is_running(_: argparse.Namespace) -> int:
    print("running" if is_codex_running() else "not-running")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="codex-api-switch",
        description="Switch Codex config between OpenAI and DeepSeek.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    deepseek = sub.add_parser("deepseek", help="Switch to DeepSeek (and sync history labels)")
    deepseek.add_argument("--api-key", help="DeepSeek API key (starts with sk-)")
    deepseek.add_argument("--no-sync", action="store_true", help="Do not relabel existing history")
    deepseek.set_defaults(func=command_deepseek)

    openai_cmd = sub.add_parser("openai", help="Restore OpenAI config (and sync history labels)")
    openai_cmd.add_argument("--no-sync", action="store_true", help="Do not relabel existing history")
    openai_cmd.set_defaults(func=command_openai)

    sync = sub.add_parser("sync", help="Relabel history to the active provider")
    sync.add_argument("--target", choices=[DEEPSEEK_PROVIDER, "openai"],
                      help="Provider to relabel history to (default: current config)")
    sync.add_argument("--dry-run", action="store_true", help="Only show what would change")
    sync.add_argument("-y", "--yes", action="store_true", help="Skip confirmation prompt")
    sync.set_defaults(func=command_sync)

    key = sub.add_parser(
        "key",
        help="Manage the saved DeepSeek API key (persists across switches)",
    )
    key_sub = key.add_subparsers(dest="action")
    key_sub.add_parser("status", help="Show whether a key is saved (masked)")
    key_set = key_sub.add_parser("set", help="Save or update the DeepSeek API key")
    key_set.add_argument("value", help="DeepSeek API key (starts with sk-)")
    key_sub.add_parser("clear", help="Forget the saved key")
    key.set_defaults(func=command_key)

    status = sub.add_parser("status", help="Show current provider")
    status.add_argument("--json", action="store_true", help="Machine-readable JSON output")
    status.set_defaults(func=command_status)

    sub.add_parser("is-running", help="Print running/not-running for the desktop app").set_defaults(
        func=command_is_running
    )

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.func(args)
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
