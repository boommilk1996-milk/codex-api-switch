#!/usr/bin/env python3
"""Switch Codex between the default provider and DeepSeek Responses API.

Also syncs the ``model_provider`` label of local conversation history so that
every task stays visible in the desktop sidebar after a provider switch.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import platform
import re
import shutil
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        print(
            "tomllib (Python 3.11+) or tomli is required. "
            "Install with: pip3 install tomli",
            file=sys.stderr,
        )
        raise SystemExit(1)


DEEPSEEK_MODEL = "deepseek-v4-flash"
DEEPSEEK_PRO_MODEL = "deepseek-v4-pro"
DEFAULT_DEEPSEEK_MODEL = DEEPSEEK_PRO_MODEL
DEEPSEEK_MODEL_VERSION = "DeepSeek-V4-Flash-0731"
DEEPSEEK_PRO_MODEL_VERSION = "DeepSeek-V4-Pro-0813"
DEEPSEEK_PROVIDER = "deepseek"
DEEPSEEK_BASE_URL = "https://api.deepseek.com/"
BACKUP_NAME = "codex-api-switch"


def codex_home() -> Path:
    override = os.environ.get("CODEX_SWITCH_HOME")
    if override:
        return Path(override).expanduser()
    return Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()


def config_path() -> Path:
    return codex_home() / "config.toml"


def models_path() -> Path:
    return codex_home() / "models.json"


def backup_dir() -> Path:
    return codex_home() / "backups" / BACKUP_NAME


def state_db_path() -> Path:
    return codex_home() / "state_5.sqlite"


def connect_state_db_readonly(db: Path) -> sqlite3.Connection | None:
    """Open the state db read-only, retrying briefly.

    Codex can briefly make the database unopenable while it recreates or
    upgrades state_5.sqlite (typically while the desktop app is running or
    right after quitting it). Returns None after retries so callers can
    degrade gracefully instead of crashing with a bare sqlite error.
    """
    for _ in range(3):
        try:
            return sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        except sqlite3.Error:
            time.sleep(0.5)
    return None


def session_index_path() -> Path:
    return codex_home() / "session_index.jsonl"


def model_catalog_value() -> str:
    if os.environ.get("CODEX_SWITCH_HOME") or os.environ.get("CODEX_HOME"):
        return str(models_path())
    return "~/.codex/models.json"


def load_text(path: Path) -> str:
    if not path.exists():
        return ""
    return path.read_text(encoding="utf-8")


def parse_toml(text: str) -> dict:
    if not text.strip():
        return {}
    return tomllib.loads(text)


def quote(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def section_bounds(lines: list[str], section: str) -> tuple[int, int] | None:
    header = f"[{section}]"
    start = None
    for index, line in enumerate(lines):
        if line.strip() == header:
            start = index
            break
    if start is None:
        return None
    end = len(lines)
    for index in range(start + 1, len(lines)):
        stripped = lines[index].strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            end = index
            break
    return start, end


def split_top_level(lines: list[str]) -> tuple[list[str], list[str]]:
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            return lines[:index], lines[index:]
    return lines, []


def remove_top_keys(top_lines: list[str], keys: set[str]) -> list[str]:
    pattern = re.compile(r"^\s*([A-Za-z0-9_-]+)\s*=")
    kept: list[str] = []
    for line in top_lines:
        match = pattern.match(line)
        if match and match.group(1) in keys:
            continue
        kept.append(line)
    while kept and not kept[0].strip():
        kept.pop(0)
    return kept


def render_deepseek_config(
    existing_text: str, token: str, model: str = DEFAULT_DEEPSEEK_MODEL
) -> str:
    lines = existing_text.splitlines()
    top_lines, rest = split_top_level(lines)
    top_values = {
        "model": model,
        "model_provider": DEEPSEEK_PROVIDER,
        "preferred_auth_method": "apikey",
        "forced_login_method": "api",
        "model_reasoning_effort": "high",
        "model_catalog_json": model_catalog_value(),
    }
    new_top = [f"{key} = {quote(value)}" for key, value in top_values.items()]
    remaining_top = remove_top_keys(top_lines, set(top_values))
    if remaining_top:
        new_top.extend(["", *remaining_top])

    bounds = section_bounds(rest, f"model_providers.{DEEPSEEK_PROVIDER}")
    if bounds:
        start, end = bounds
        rest = rest[:start] + rest[end:]

    while rest and not rest[-1].strip():
        rest.pop()

    provider = [
        "",
        f"[model_providers.{DEEPSEEK_PROVIDER}]",
        f"name = {quote(DEEPSEEK_PROVIDER)}",
        f"base_url = {quote(DEEPSEEK_BASE_URL)}",
        'wire_api = "responses"',
        f"experimental_bearer_token = {quote(token)}",
    ]
    rendered = "\n".join([*new_top, *rest, *provider]).rstrip() + "\n"
    parse_toml(rendered)
    return rendered


def write_models_catalog() -> None:
    source = Path(__file__).with_name("deepseek-models.json")
    if source.exists():
        data = json.loads(source.read_text(encoding="utf-8"))
    else:
        data = {
            "models": [
                {
                    "slug": DEEPSEEK_MODEL,
                    "display_name": DEEPSEEK_MODEL_VERSION,
                    "description": "DeepSeek V4 Flash 0731 (latest official release).",
                    "context_window": 1048576,
                    "max_context_window": 1048576,
                    "supported_in_api": True,
                    "visibility": "list",
                }
            ]
        }
    slugs = {item.get("slug") for item in data.get("models", [])}
    if DEEPSEEK_MODEL not in slugs:
        raise SystemExit("models catalog is missing deepseek-v4-flash")
    models_path().write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def make_backup(label: str) -> None:
    backup_dir().mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    if config_path().exists():
        shutil.copy2(config_path(), backup_dir() / f"config-{label}-{stamp}.toml")
    if models_path().exists():
        shutil.copy2(models_path(), backup_dir() / f"models-{label}-{stamp}.json")


def save_restore_points() -> None:
    backup_dir().mkdir(parents=True, exist_ok=True)
    parsed = parse_toml(load_text(config_path()))
    current_provider = parsed.get("model_provider")
    if current_provider != DEEPSEEK_PROVIDER and config_path().exists():
        shutil.copy2(config_path(), backup_dir() / "openai-last.toml")
    if models_path().exists():
        shutil.copy2(models_path(), backup_dir() / "models-last.json")
        (backup_dir() / "models-was-absent").unlink(missing_ok=True)
    else:
        (backup_dir() / "models-was-absent").write_text("1\n", encoding="utf-8")
        (backup_dir() / "models-last.json").unlink(missing_ok=True)


def existing_token(parsed: dict) -> str | None:
    provider_token = (
        parsed.get("model_providers", {})
        .get(DEEPSEEK_PROVIDER, {})
        .get("experimental_bearer_token")
    )
    if provider_token:
        return str(provider_token)
    env_token = os.environ.get("DEEPSEEK_API_KEY")
    if env_token:
        return env_token
    shell_token = (
        parsed.get("shell_environment_policy", {})
        .get("set", {})
        .get("ANTHROPIC_AUTH_TOKEN")
    )
    if shell_token:
        return str(shell_token)
    return None


def key_store_path() -> Path:
    return backup_dir() / "deepseek-key"


def load_stored_key() -> str | None:
    """Return the DeepSeek API key saved across provider switches, if any."""
    path = key_store_path()
    if not path.exists():
        return None
    try:
        token = path.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    return token or None


def save_deepseek_key(token: str) -> None:
    """Persist the DeepSeek API key so it survives switches back to OpenAI."""
    backup_dir().mkdir(parents=True, exist_ok=True)
    path = key_store_path()
    path.write_text(token.strip() + "\n", encoding="utf-8")
    try:
        path.chmod(0o600)
    except OSError:
        pass


def clear_deepseek_key() -> None:
    key_store_path().unlink(missing_ok=True)


def clear_stale_model_cache() -> bool:
    """Back up and remove Codex's provider model cache after a switch.

    Codex desktop keeps models_cache.json fetched from the previous
    provider; after switching it can still show/select old model names
    (e.g. gpt-5.6-sol) and send them to the new provider. Removing the
    cache makes Codex reload models for the active provider on restart.
    Returns True when a cache file was removed.
    """
    path = codex_home() / "models_cache.json"
    if not path.exists():
        return False
    backup_dir().mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    shutil.copy2(path, backup_dir() / f"models_cache-removed-{stamp}.json")
    path.unlink()
    return True


def masked_key(token: str | None) -> str:
    if not token:
        return "(not set)"
    if len(token) <= 10:
        return "(set)"
    return token[:5] + "***" + token[-4:]


def is_codex_running() -> bool:
    """Detect whether the Codex desktop app (ChatGPT/Codex app-server) is running."""
    if platform.system() == "Windows":
        for image in ("ChatGPT.exe", "Codex.exe"):
            try:
                result = subprocess.run(
                    ["tasklist", "/FI", f"IMAGENAME eq {image}", "/NH"],
                    capture_output=True, text=True, timeout=5,
                )
                if image.lower() in result.stdout.lower():
                    return True
            except (FileNotFoundError, subprocess.TimeoutExpired):
                continue
        return False
    sock = codex_home() / "ipc" / "ipc.sock"
    try:
        result = subprocess.run(
            ["lsof", str(sock)],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode == 0 and result.stdout.strip():
            return True
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    # With a simulated home (CODEX_SWITCH_HOME), only the local socket counts.
    if os.environ.get("CODEX_SWITCH_HOME"):
        return False
    for pattern in (
        "ChatGPT.app/Contents/MacOS/ChatGPT",
        "Codex.app/Contents/MacOS/Codex",
        "com.openai.codex",
    ):
        try:
            result = subprocess.run(
                ["pgrep", "-f", pattern],
                capture_output=True, text=True, timeout=5,
            )
            if result.returncode == 0 and result.stdout.strip():
                return True
        except (FileNotFoundError, subprocess.TimeoutExpired):
            pass
    return False


def get_status_dict() -> dict:
    """Return current status as a dict for JSON output."""
    text = load_text(config_path())
    parsed = parse_toml(text)
    provider = parsed.get("model_provider")
    model = parsed.get("model", "(not set)")
    deepseek = parsed.get("model_providers", {}).get(DEEPSEEK_PROVIDER, {})
    has_restore = (backup_dir() / "openai-last.toml").exists()
    is_deepseek = provider == DEEPSEEK_PROVIDER

    last_switch = None
    if has_restore:
        try:
            restore_stat = (backup_dir() / "openai-last.toml").stat()
            last_switch = datetime.fromtimestamp(restore_stat.st_mtime, tz=timezone.utc).isoformat()
        except OSError:
            pass

    return {
        "codex_home": str(codex_home()),
        "model": model,
        "provider": provider if provider else "openai",
        "is_deepseek": is_deepseek,
        "deepseek_configured": bool(deepseek),
        "deepseek_key_available": bool(deepseek.get("experimental_bearer_token"))
        or load_stored_key() is not None,
        "deepseek_base_url": deepseek.get("base_url") if deepseek else None,
        "restore_available": has_restore,
        "last_restore_point": last_switch,
        "codex_running": is_codex_running(),
    }


