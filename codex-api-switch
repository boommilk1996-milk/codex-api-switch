USER_TASKS_SQL = """
SELECT id, rollout_path, model_provider, title, model
FROM threads
WHERE archived = 0
  AND (thread_source = 'user' OR thread_source IS NULL OR thread_source = '')
ORDER BY id
"""


def user_tasks(conn: sqlite3.Connection) -> list[dict]:
    rows = conn.execute(USER_TASKS_SQL).fetchall()
    return [
        {"id": r[0], "rollout_path": r[1], "provider": r[2], "title": r[3] or "", "model": r[4]}
        for r in rows
    ]


def current_provider_from_config() -> str | None:
    parsed = parse_toml(load_text(config_path()))
    return parsed.get("model_provider")


def target_default_model(target: str) -> str | None:
    """Model to relabel sessions to when syncing to ``target``."""
    if target == DEEPSEEK_PROVIDER:
        parsed = parse_toml(load_text(config_path()))
        return parsed.get("model") or DEEPSEEK_MODEL
    restore = backup_dir() / "openai-last.toml"
    if not restore.exists():
        return None
    try:
        parsed = parse_toml(restore.read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        return None
    return parsed.get("model") or None


def rewrite_session_model_fields(obj: dict, new_model: str, new_provider: str) -> int:
    """Rewrite model-related fields inside a parsed rollout JSON object.

    Returns how many fields changed. The rollout JSON keeps its structure;
    only the session-level model settings are rebind to the target provider so
    the desktop app stops sending the old provider's model name.
    """
    changed = 0
    payload = obj.get("payload")
    if not isinstance(payload, dict):
        return 0

    def set_model(o: dict, keys: tuple[str, ...], value: str) -> bool:
        nonlocal changed
        if isinstance(o, dict) and all(k in o for k in keys):
            if o.get(keys[-1]) != value:
                o[keys[-1]] = value
                changed += 1
            return True
        return False

    ts = payload.get("thread_settings")
    if isinstance(ts, dict):
        if set_model(ts, ("model",), new_model):
            pass
        if ts.get("model_provider_id") != new_provider:
            ts["model_provider_id"] = new_provider
            changed += 1
        collab = ts.get("collaboration_mode")
        if isinstance(collab, dict):
            s = collab.get("settings")
            if isinstance(s, dict):
                set_model(s, ("model",), new_model)

    cm = payload.get("collaboration_mode")
    if isinstance(cm, dict):
        s = cm.get("settings")
        if isinstance(s, dict):
            set_model(s, ("model",), new_model)

    state = payload.get("state")
    if isinstance(state, dict):
        set_model(state, ("model",), new_model)
        personality = state.get("personality")
        if isinstance(personality, dict):
            set_model(personality, ("model",), new_model)

    # turn_context keeps a per-turn model record; rebind it too so the app
    # never replays the old model name when resuming the thread.
    set_model(payload, ("model",), new_model)
    return changed


def rewrite_session_model_file(path: Path, new_model: str, new_provider: str) -> int:
    """Rewrite model-related fields in every JSON line of a rollout file.

    Returns the total number of field changes across the file. Lines that do
    not parse or contain no model fields are kept byte-for-byte.
    """
    raw = path.read_bytes()
    trailing_newline = raw.endswith(b"\n")
    lines = raw.splitlines()
    out: list[bytes] = []
    total_changed = 0
    for line in lines:
        stripped = line.strip()
        if not stripped:
            out.append(line)
            continue
        try:
            obj = json.loads(stripped)
        except json.JSONDecodeError:
            out.append(line)
            continue
        if not isinstance(obj, dict):
            out.append(line)
            continue
        changed = rewrite_session_model_fields(obj, new_model, new_provider)
        if changed:
            out.append(
                json.dumps(obj, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
            )
            total_changed += changed
        else:
            out.append(line)
    new_raw = b"\n".join(out) + (b"\n" if trailing_newline else b"")
    path.write_bytes(new_raw)
    return total_changed


def plan_sync(target: str) -> dict:
    """Build a read-only plan of what a sync would change."""
    db = state_db_path()
    plan = {
        "target_provider": target,
        "state_db": str(db),
        "state_db_exists": db.exists(),
        "to_update": [],
        "skipped": [],
        "errors": [],
        "session_index_missing_ids": [],
    }
    if not db.exists():
        plan["errors"].append("state_5.sqlite not found; nothing to sync")
        return plan
    conn = connect_state_db_readonly(db)
    if conn is None:
        plan["errors"].append(
            "state_5.sqlite 暂时无法打开（Codex 可能在运行或正在升级数据库）。\n"
            "请完全退出 Codex（Cmd+Q）后重试；历史标签未同步。"
        )
        return plan
    try:
        tasks = user_tasks(conn)
    finally:
        conn.close()

    index_ids = set()
    index_path = session_index_path()
    if index_path.exists():
        for line in index_path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                index_ids.add(json.loads(line).get("id"))
            except json.JSONDecodeError:
                plan["errors"].append(f"session_index.jsonl has an unparseable line: {line[:80]}")

    for task in tasks:
        if task["provider"] == target:
            continue
        entry = {
            "id": task["id"],
            "provider": task["provider"],
            "rollout_path": task["rollout_path"],
            "model": task.get("model"),
        }
        path = Path(task["rollout_path"]) if task["rollout_path"] else None
        if path is None or not path.is_file():
            entry["reason"] = "rollout file missing"
            plan["skipped"].append(entry)
            continue
        ok, reason = validate_first_line(path, task["id"], task["provider"])
        if not ok:
            entry["reason"] = reason
            plan["skipped"].append(entry)
            continue
        plan["to_update"].append(entry)
        if task["id"] not in index_ids:
            plan["session_index_missing_ids"].append(task["id"])
    return plan


def validate_first_line(path: Path, expected_id: str, expected_provider: str) -> tuple[bool, str]:
    try:
        raw = path.read_bytes()
    except OSError as exc:
        return False, f"cannot read: {exc}"
    nl = raw.find(b"\n")
    if nl == -1:
        return False, "no newline in rollout file"
    first = raw[:nl]
    try:
        obj = json.loads(first.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return False, "first line is not valid JSON"
    payload = obj.get("payload") if isinstance(obj, dict) else None
    if not isinstance(payload, dict):
        return False, "session_meta payload missing"
    if payload.get("id") != expected_id:
        return False, "session_meta id mismatch"
    if payload.get("model_provider") != expected_provider:
        return False, (
            f"first-line provider is {payload.get('model_provider')!r}, "
            f"expected {expected_provider!r}"
        )
    return True, ""


def new_first_line(path: Path, new_provider: str) -> str:
    raw = path.read_bytes()
    nl = raw.find(b"\n")
    first = raw[:nl].decode("utf-8")
    obj = json.loads(first)
    old = obj["payload"]["model_provider"]
    # Match the key plus the string value, regardless of spacing:
    #   "model_provider":"openai"   (compact)  or
    #   "model_provider": "openai"  (spaced)
    marker = re.compile(r'"model_provider"\s*:\s*"([^"]*)"')
    match = marker.search(first)
    if not match:
        raise ValueError("model_provider marker not found on first line")
    if match.group(1) != old:
        raise ValueError("model_provider value mismatch on first line")
    updated = first[: match.start(1)] + new_provider + first[match.end(1) :]
    parsed = json.loads(updated)
    if parsed["payload"]["model_provider"] != new_provider:
        raise ValueError("first-line rewrite did not change provider")
    return updated


def replace_first_line_bytes(path: Path, new_first_line: str) -> None:
    raw = path.read_bytes()
    nl = raw.find(b"\n")
    if nl == -1:
        raise ValueError("rollout file has no newline")
    rest = raw[nl:]
    path.write_bytes(new_first_line.encode("utf-8") + rest)


def sync_history(target: str, dry_run: bool = False) -> dict:
    """Sync history labels to ``target``. Returns a result dict."""
    result = {
        "target_provider": target,
        "target_model": target_default_model(target),
        "dry_run": dry_run,
        "updated": 0,
        "models_relabeled": 0,
        "skipped": 0,
        "errors": [],
        "index_merged": 0,
        "backup_dir": None,
    }
    db = state_db_path()
    if not db.exists():
        result["errors"].append("state_5.sqlite not found; nothing to sync")
        return result

    plan = plan_sync(target)
    result["errors"] = list(plan["errors"])
    to_update = plan["to_update"]
    skipped = plan["skipped"]
    new_model = result["target_model"]
    if new_model is None:
        result["errors"].append(
            "Cannot determine the target model (missing restore point for OpenAI); "
            "provider labels will still sync."
        )
    result["skipped"] = len(skipped)
    for entry in skipped:
        print(f"  skip  {entry['id']}: {entry.get('reason', '?')}")

    if dry_run:
        result["updated"] = len(to_update)
        if new_model:
            result["models_relabeled"] = len(to_update)
        return result

    if is_codex_running():
        result["errors"].append(
            "Codex desktop is still running. Fully quit Codex, then rerun the sync."
        )
        return result

    if not to_update:
        return result

    # ── backup ─────────────────────────────────────────────────────────────
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    snap = backup_dir() / f"sync-{stamp}"
    snap.mkdir(parents=True, exist_ok=True)
    result["backup_dir"] = str(snap)

    manifest: dict[str, dict] = {}
    backup_conn = connect_state_db_readonly(db)
    if backup_conn is None:
        result["errors"].append(
            "state_5.sqlite 暂时无法打开（Codex 可能在运行或正在升级数据库），历史标签未同步。\n"
            "请完全退出 Codex（Cmd+Q）后重试。"
        )
        return result
    try:
        target_bak = snap / "state_5.sqlite.bak"
        backup_target = sqlite3.connect(target_bak)
        backup_conn.backup(backup_target)
        backup_target.close()
        backup_conn.close()
    except Exception as exc:  # noqa: BLE001
        result["errors"].append(f"database backup failed: {exc}")
        return result

    for entry in to_update:
        path = Path(entry["rollout_path"])
        try:
            raw = path.read_bytes()
            nl = raw.find(b"\n")
            first_b64 = base64.b64encode(raw[:nl]).decode("ascii")
            rest_sha = hashlib.sha256(raw[nl:]).hexdigest()
        except OSError as exc:
            result["errors"].append(f"cannot read rollout for backup {entry['id']}: {exc}")
            continue
        manifest[entry["id"]] = {
            "path": str(path),
            "first_line_b64": first_b64,
            "rest_sha256": rest_sha,
            "provider": entry["provider"],
            "model": entry.get("model"),
        }
    (snap / "manifest.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

    # ── rewrite rollout first lines ────────────────────────────────────────
    rewritten: list[str] = []
    for entry in to_update:
        path = Path(entry["rollout_path"])
        try:
            updated = new_first_line(path, target)
            replace_first_line_bytes(path, updated)
            if new_model:
                rewrite_session_model_file(path, new_model, target)
            rewritten.append(entry["id"])
        except Exception as exc:  # noqa: BLE001
            result["errors"].append(f"rollout rewrite failed for {entry['id']}: {exc}")

    # ── update sqlite (only rows whose rollout was rewritten) ──────────────
    if rewritten:
        conn = None
        try:
            conn = sqlite3.connect(db)
            conn.execute("BEGIN IMMEDIATE")
            placeholders = ",".join("?" for _ in rewritten)
            if new_model:
                sql = (
                    f"UPDATE threads SET model_provider = ?, model = ? "
                    f"WHERE id IN ({placeholders})"
                )
                params: list = [target, new_model, *rewritten]
            else:
                sql = f"UPDATE threads SET model_provider = ? WHERE id IN ({placeholders})"
                params = [target, *rewritten]
            cur = conn.execute(
                sql, params
            )
            conn.commit()
            result["updated"] = cur.rowcount
            if new_model:
                result["models_relabeled"] = len(rewritten)
        except Exception as exc:  # noqa: BLE001
            if conn is not None:
                conn.rollback()
            result["errors"].append(f"database update failed: {exc}")
            # Roll back rollout first lines already rewritten
            for thread_id in rewritten:
                info = manifest.get(thread_id)
                if not info:
                    continue
                try:
                    orig = base64.b64decode(info["first_line_b64"]).decode("utf-8")
                    replace_first_line_bytes(Path(info["path"]), orig)
                except Exception:  # noqa: BLE001
                    result["errors"].append(
                        f"rollback of {thread_id} failed; restore from {snap}"
                    )
        finally:
            if conn is not None:
                conn.close()

    # ── merge missing ids into session_index.jsonl ─────────────────────────
    missing = [tid for tid in plan["session_index_missing_ids"] if tid in rewritten]
    if missing:
        index_path = session_index_path()
        lines = index_path.read_text(encoding="utf-8").splitlines() if index_path.exists() else []
        known = set()
        for line in lines:
            line = line.strip()
            if not line:
                continue
            try:
                known.add(json.loads(line).get("id"))
            except json.JSONDecodeError:
                continue
        title_map = {}
        merge_conn = connect_state_db_readonly(db)
        if merge_conn is not None:
            try:
                title_map = {t["id"]: t["title"] for t in user_tasks(merge_conn)}
            finally:
                merge_conn.close()
        added = []
        for tid in missing:
            if tid in known:
                continue
            added.append(
                json.dumps(
                    {
                        "id": tid,
                        "thread_name": title_map.get(tid) or "",
                        "updated_at": datetime.now(timezone.utc).isoformat(),
                    },
                    ensure_ascii=False,
                )
            )
        if added:
            index_path.write_text(
                "\n".join([*lines, *added]) + ("\n" if lines else ""),
                encoding="utf-8",
            )
            result["index_merged"] = len(added)

    return result


def command_sync(args: argparse.Namespace) -> int:
    target = args.target or current_provider_from_config()
    if not target:
        print("Cannot determine target provider (no --target and no config).", file=sys.stderr)
        return 2

    plan = plan_sync(target)
    print(f"Target provider: {target}")
    print(f"State db: {plan['state_db']}")
    print(f"Tasks to relabel: {len(plan['to_update'])}")
    print(f"Tasks skipped (need attention): {len(plan['skipped'])}")
    for entry in plan["skipped"]:
        print(f"  - {entry['id']} ({entry['provider']}): {entry.get('reason', '?')}")
    for error in plan["errors"]:
        print(f"ERROR: {error}", file=sys.stderr)

    if plan["errors"]:
        return 1

    if args.dry_run:
        print("Dry run: no files were changed.")
        return 0

    if plan["to_update"]:
        if is_codex_running():
            print(
                "Codex desktop is still running.\n"
                "Fully quit Codex (Cmd+Q), then run: codex-api-switch sync "
                + (f"--target {target}" if args.target else ""),
                file=sys.stderr,
            )
            return 3
        if not args.yes:
            answer = input(
                f"Relabel {len(plan['to_update'])} conversation(s) to '{target}'? [y/N] "
            ).strip().lower()
            if answer not in ("y", "yes"):
                print("Aborted.")
                return 0

    result = sync_history(target)
    print(f"Updated: {result['updated']} conversations")
    if result["models_relabeled"]:
        print(f"Models relabeled: {result['models_relabeled']} conversation(s) -> {result['target_model']}")
    if result["index_merged"]:
        print(f"session_index.jsonl: merged {result['index_merged']} missing id(s)")
    if result["backup_dir"]:
        print(f"Backup: {result['backup_dir']}")
    for error in result["errors"]:
        print(f"ERROR: {error}", file=sys.stderr)
    return 1 if result["errors"] else 0


# --------------------------------------------------------------------------- #
# History repair (reasoning replay compatibility)
# --------------------------------------------------------------------------- #
#
# Sessions advanced under a third-party provider (e.g. DeepSeek) store
# plaintext reasoning content in their rollout files. When the conversation is
# resumed after switching back to the official provider, the API rejects the
# replayed history with 400 "Invalid 'input[i].content': array too long /
# array_above_max_length" because reasoning items must have an empty content
# array. The fix is to empty the content of those reasoning items.

REASONING_TYPE = "reasoning"


def all_rollout_paths() -> tuple[list[Path], str | None]:
    """All rollout files plus a warning when the state db could not be read.

    Returns (paths, db_warning): paths are sorted and deduplicated from both
    the sessions tree and the threads table; db_warning is set when the db is
    present but unreadable, so callers know the list may be incomplete.
    """
    paths: dict[Path, None] = {}
    db_warning: str | None = None
    sessions_dir = codex_home() / "sessions"
    if sessions_dir.is_dir():
        for path in sessions_dir.rglob("rollout-*.jsonl"):
            paths[path] = None
    db = state_db_path()
    if db.exists():
        conn = connect_state_db_readonly(db)
        if conn is None:
            db_warning = (
                "state_5.sqlite 暂时无法读取，仅按 sessions 目录扫描；"
                "若结果不全，请完全退出 Codex（Cmd+Q）后重试。"
            )
        else:
            try:
                rows = conn.execute("SELECT rollout_path FROM threads").fetchall()
            finally:
                conn.close()
            for (raw,) in rows:
                if not raw:
                    continue
                path = Path(raw).expanduser()
                if path.is_file():
                    paths[path] = None
    return sorted(paths), db_warning


def resolve_rollout_path(session: str) -> Path:
    candidates: list[Path] = []
    seen: set[Path] = set()
    paths, _db_warning = all_rollout_paths()
    for path in paths:
        if session in path.name and path not in seen:
            candidates.append(path)
            seen.add(path)
    db = state_db_path()
    if db.exists():
        conn = connect_state_db_readonly(db)
        if conn is not None:
            try:
                rows = conn.execute(
                    "SELECT id, rollout_path FROM threads WHERE id = ? OR rollout_path LIKE ?",
                    (session, f"%{session}%"),
                ).fetchall()
            finally:
                conn.close()
            for _tid, raw in rows:
                if not raw:
                    continue
                path = Path(raw).expanduser()
                if path.is_file() and path not in seen:
                    candidates.append(path)
                    seen.add(path)
    if not candidates:
        raise ValueError(
            f"No rollout file matches session id '{session}'. "
            "Pass the full session id (e.g. 019fcb99-1c6f-74c2-a5bb-f390a2013653)."
        )
    if len(candidates) > 1:
        names = ", ".join(p.name for p in candidates[:5])
        raise ValueError(f"Session id '{session}' matches multiple rollouts: {names}")
    return candidates[0]


def scan_reasoning(path: Path) -> tuple[int, int]:
    """Return (total reasoning items, reasoning items with non-empty content)."""
    total = 0
    bad = 0
    try:
        lines = path.read_bytes().splitlines()
    except OSError:
        return 0, 0
    for line in lines:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        payload = obj.get("payload") if isinstance(obj, dict) else None
        if not isinstance(payload, dict):
            continue
        if payload.get("type") != REASONING_TYPE:
            continue
        total += 1
        content = payload.get("content")
        if isinstance(content, list) and content:
            bad += 1
    return total, bad


def rewrite_reasoning_content(path: Path) -> int:
    """Empty the content array of reasoning items. Returns how many changed."""
    raw = path.read_bytes()
    trailing_newline = raw.endswith(b"\n")
    lines = raw.splitlines()
    out: list[bytes] = []
    changed = 0
    for line in lines:
        stripped = line.strip()
        if not stripped:
            out.append(line)
            continue
        try:
            obj = json.loads(stripped)
        except json.JSONDecodeError:
            out.append(line)
            continue
        payload = obj.get("payload") if isinstance(obj, dict) else None
        if not isinstance(payload, dict) or payload.get("type") != REASONING_TYPE:
            out.append(line)
            continue
        content = payload.get("content")
        if not (isinstance(content, list) and content):
            out.append(line)
            continue
        payload["content"] = []
        out.append(json.dumps(obj, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))
        changed += 1
    new_raw = b"\n".join(out) + (b"\n" if trailing_newline else b"")
    path.write_bytes(new_raw)
    return changed


def backup_rollouts(paths: list[Path]) -> Path:
    """Copy rollout files (plus a sha256 manifest) into a repair-<ts> snapshot."""
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    snap = backup_dir() / f"repair-{stamp}"
    snap.mkdir(parents=True, exist_ok=True)
    manifest: dict[str, dict] = {}
    for path in paths:
        rel = path.relative_to(codex_home())
        target = snap / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
        manifest[str(path)] = {
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            "backup": str(target),
        }
    (snap / "manifest.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    return snap


def scan_all_rollouts() -> tuple[list[tuple[Path, int, int]], str | None]:
    """Return (repair plan, db warning) across every rollout."""
    paths, db_warning = all_rollout_paths()
    plan = []
    for path in paths:
        total, bad = scan_reasoning(path)
        if bad:
            plan.append((path, total, bad))
    return plan, db_warning


def apply_repairs(plan: list[tuple[Path, int, int]]) -> tuple[Path, int]:
    """Back up and repair every rollout in ``plan``. Returns (backup_dir, changed)."""
    snap = backup_rollouts([path for path, _, _ in plan])
    changed = 0
    for path, _total, bad in plan:
        repaired = rewrite_reasoning_content(path)
        changed += repaired
        if repaired != bad:
            raise ValueError(f"{path.name}: expected {bad} changes, applied {repaired}")
    return snap, changed


def command_repair(args: argparse.Namespace) -> int:
    if args.all and args.session:
        print("Specify either a session id or --all, not both.", file=sys.stderr)
        return 2
    if not args.all and not args.session:
        print("Specify a session id or --all.", file=sys.stderr)
        return 2

    if args.all:
        plan, db_warning = scan_all_rollouts()
        if db_warning:
            print(f"WARNING: {db_warning}", file=sys.stderr)
    else:
        try:
            path = resolve_rollout_path(args.session)
        except ValueError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            return 1
        total, bad = scan_reasoning(path)
        plan = [(path, total, bad)] if bad else []

    scanned = len(all_rollout_paths()[0]) if args.all else 1
    print(f"Sessions scanned: {scanned}")
    print(f"Sessions to repair: {len(plan)}")
    for path, total, bad in plan:
        print(
            f"  {path.name}: {bad} reasoning item(s) with content to empty "
            f"(of {total} reasoning item(s))"
        )

    if args.dry_run or not plan:
        if args.dry_run:
            print("Dry run: no files were changed.")
        return 0

    if is_codex_running() and not args.force:
        print(
            "Codex desktop is still running.\n"
            "Fully quit Codex (Cmd+Q), then run: codex-api-switch repair "
            + ("--all" if args.all else args.session),
            file=sys.stderr,
        )
        return 3

    if not args.yes:
        answer = input(
            f"Empty reasoning content in {len(plan)} session(s)? "
            "A backup is created first. [y/N] "
        ).strip().lower()
        if answer not in ("y", "yes"):
            print("Aborted.")
            return 0

    try:
        snap, changed = apply_repairs(plan)
    except Exception as exc:  # noqa: BLE001
        print(f"ERROR: repair failed: {exc}", file=sys.stderr)
        return 1

    print(f"Repaired: {changed} reasoning item(s) in {len(plan)} session(s)")
    print(f"Backup: {snap}")
    remaining = sum(scan_reasoning(path)[1] for path, _, _ in plan)
    if remaining:
        print(f"WARNING: {remaining} reasoning item(s) still have content", file=sys.stderr)
        return 1
    return 0


